//-*- mode: jsonc -*-
{
    "layer": "top", 
    "position": "top", 
    "height": 15, 
    "spacing": 2, 

    // Choose the order of the modules
    "modules-left": [
        "ext/workspaces",
        "custom/sep",
        "mango/window"
        // "custom/sep"
    ],
    "modules-center": [
    ],

    "modules-right": [
	"tray",
        "custom/sep",
        "network",
        "custom/sep",
        "cpu",
        "custom/sep",
        "memory",
        "custom/sep",
        "clock"
    ],

    // Modules configuration
    "ext/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}",
	    "ignore-hidden": false,
	    "on-click": "activate",
	    "sort-by-id": true,
        "persistent-workspaces": {
            "*" : 4
        }
    },

    /*"mango/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },*/

    "mango/window": {
        "format": "{title}",
        "max-length": 40,
        "expand": true
    },

    /*"dwl/window": {
        "format": "{title}",
        "max-length": 40
    },*/

    "tray": {
        "icon-size": 15,
        "spacing": 10,
        "icons": {
            "blueman": "bluetooth",
            "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png",
	    "Discord": "$HOME/.local/share/icons/hicolor/16x16/apps/discord.png"
        }
    },
    "clock": {
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "CPU: {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": "Mem: {used}GiB"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "Bat: {capacity}% {icon} {time}",
        "format-plugged": "{capacity}% ",
        "format-alt": "Bat {capacity}%",
        "format-time": "{H}:{M}",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format": "Online",
        "format-disconnected": "Disconnected ⚠"
    },
    "custom/sep": {
        "format" : "|",
        "interval" : 0
    }
}
